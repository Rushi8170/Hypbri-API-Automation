<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Suite" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.framework.tests.api.UserAPITest"/>
            <class name="com.framework.tests.api.AuthAPITest"/>
        </classes>
    </test>

</suite>
