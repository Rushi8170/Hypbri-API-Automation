<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <test name="API Regression Tests">
        <groups>
            <run>
                <include name="api"/>
                <include name="regression"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.api.UserAPITest"/>
            <class name="com.framework.tests.api.AuthAPITest"/>
        </classes>
    </test>

</suite>
